// Graapes HRMS - database schema (Phase 1)
// Design notes live in docs/database-design.md.
// IMPORTANT (2 developers): only the Technical Lead edits this file. Others ask for changes via a GitHub issue.
//
// Values marked "DEMO DEFAULT" are NOT client-approved policy (see docs/open-business-decisions.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  SUPER_ADMIN
  HR_ADMIN
  MANAGER
  EMPLOYEE
  FINANCE // optional role (BRD 5); payroll stays disabled
}

enum EmploymentType { // DEMO DEFAULT values; HR must approve (BRD 7.1)
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  NOTICE_PERIOD
  EXITED
}

enum PunchType {
  IN
  OUT
}

enum PunchSource {
  WEB_SELF // employee used the portal
  CORRECTION // created by an approved correction
  HR_ENTRY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  MISSING_PUNCH
  ON_LEAVE
  HOLIDAY
  // Half-day / grace rules are NOT hardcoded: OQ-04 is open. Status is computed by configurable rules.
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CLARIFICATION_REQUESTED
  CANCELLED
}

enum LedgerKind {
  OPENING
  ACCRUAL
  ADJUSTMENT
  PENDING_HOLD // days reserved by a pending request
  USED // days consumed by an approved request
  RELEASE // reverses a PENDING_HOLD/USED (reject, cancel)
}

enum HalfDayPart {
  FIRST_HALF
  SECOND_HALF
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
}

enum AudienceType {
  ALL
  DEPARTMENT
  ROLE
}

enum DocumentCategory {
  RESUME
  ID_PROOF
  ADDRESS_PROOF
  SIGNED_LETTER
  CERTIFICATE
  OTHER
}

enum LetterType { // subject to client approval (OQ-08)
  OFFER
  APPOINTMENT
  INTERNSHIP_CERTIFICATE
  EXPERIENCE
}

enum LetterStatus {
  DRAFT
  ISSUED
  REVOKED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

// ───────────────────────── Identity & access ─────────────────────────

/// Login account. Separate from Employee: an account may exist without a profile (Super Admin bootstrap).
model UserAccount {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String? // null until the invited user sets a password
  role             Role
  isActive         Boolean   @default(true)
  /// Incremented on logout-all / deactivate / password change; invalidates older sessions immediately.
  tokenVersion     Int       @default(0)
  inviteTokenHash  String? // only the HASH of the one-time invite token is stored
  inviteExpiresAt  DateTime?
  lastLoginAt      DateTime?
  failedLogins     Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee Employee?

  @@index([role])
}

// ───────────────────────── Organization ─────────────────────────

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  headId    String? // department head (an Employee)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  head         Employee?  @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  employees    Employee[] @relation("EmployeeDepartment")
  designations Designation[]
  audiences    AnnouncementAudience[]
}

model Designation {
  id           String   @id @default(cuid())
  title        String
  departmentId String? // optional: designation may be shared across departments
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees  Employee[]

  @@unique([title, departmentId])
}

// ───────────────────────── Employee ─────────────────────────

model Employee {
  id                String           @id @default(cuid())
  employeeCode      String           @unique // BR-001 / FR-004
  fullName          String
  workEmail         String           @unique
  mobile            String?
  personalAddress   String?
  dateOfBirth       DateTime?        @db.Date
  profilePhotoKey   String?

  employmentType    EmploymentType
  status            EmploymentStatus @default(ACTIVE)
  joiningDate       DateTime         @db.Date
  probationEndDate  DateTime?        @db.Date
  workLocation      String?

  departmentId      String?
  designationId     String?
  managerId         String? // reporting manager (self relation)

  emergencyName     String?
  emergencyRelation String?
  emergencyPhone    String?

  resignationDate   DateTime?        @db.Date
  lastWorkingDay    DateTime?        @db.Date
  exitStatus        String?

  /// false = deactivated. Records are never hard-deleted (BR-007).
  isActive          Boolean          @default(true)
  userAccountId     String?          @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  userAccount UserAccount? @relation(fields: [userAccountId], references: [id], onDelete: SetNull)
  department  Department?  @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  designation Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  manager     Employee?    @relation("ReportingLine", fields: [managerId], references: [id], onDelete: SetNull)
  reports     Employee[]   @relation("ReportingLine")
  headOf      Department[] @relation("DepartmentHead")

  history         EmployeeHistory[]
  punches         AttendancePunch[]
  attendance      AttendanceRecord[]
  corrections     AttendanceCorrection[] @relation("CorrectionRequester")
  correctionsToDo AttendanceCorrection[] @relation("CorrectionApprover")
  leaveRequests   LeaveRequest[]         @relation("LeaveRequester")
  leaveToApprove  LeaveRequest[]         @relation("LeaveApprover")
  ledger          LeaveLedgerEntry[]
  documents       EmployeeDocument[]
  letters         HRLetter[]

  @@index([departmentId])
  @@index([managerId])
  @@index([status])
  @@index([fullName])
}

/// Field-level change history for lifecycle / organization changes (AC-03).
model EmployeeHistory {
  id          String   @id @default(cuid())
  employeeId  String
  field       String
  oldValue    String?
  newValue    String?
  changedById String? // UserAccount id (no FK so history survives account removal)
  changedAt   DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, changedAt])
}

// ───────────────────────── Attendance ─────────────────────────

/// Immutable raw punches (BRD 7.2: timestamp, identity, source). Never edited; corrections add new punches.
model AttendancePunch {
  id         String      @id @default(cuid())
  employeeId String
  type       PunchType
  at         DateTime // stored in UTC; shown in company timezone
  source     PunchSource @default(WEB_SELF)
  createdAt  DateTime    @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, at])
}

/// Daily summary, one row per employee per company-local date.
model AttendanceRecord {
  id         String           @id @default(cuid())
  employeeId String
  date       DateTime         @db.Date
  firstIn    DateTime?
  lastOut    DateTime?
  status     AttendanceStatus
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  employee    Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  corrections AttendanceCorrection[]

  @@unique([employeeId, date])
  @@index([date, status])
}

model AttendanceCorrection {
  id             String        @id @default(cuid())
  employeeId     String
  recordId       String?
  date           DateTime      @db.Date
  originalIn     DateTime? // snapshot of the original values (AC-07)
  originalOut    DateTime?
  requestedIn    DateTime?
  requestedOut   DateTime?
  reason         String
  approverId     String?
  status         RequestStatus @default(PENDING)
  decidedById    String? // UserAccount id
  decidedAt      DateTime?
  decisionComment String?
  version        Int           @default(0) // optimistic concurrency
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  employee Employee          @relation("CorrectionRequester", fields: [employeeId], references: [id], onDelete: Restrict)
  approver Employee?         @relation("CorrectionApprover", fields: [approverId], references: [id], onDelete: SetNull)
  record   AttendanceRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)

  @@index([status, approverId])
  @@index([employeeId, date])
}

// ───────────────────────── Leave ─────────────────────────

/// All entitlement values are NULL / off until HR configures them (OQ-05). Nothing is assumed.
model LeaveType {
  id                 String   @id @default(cuid())
  name               String   @unique
  code               String   @unique
  isPaid             Boolean  @default(true)
  requiresReason     Boolean  @default(false)
  allowHalfDay       Boolean  @default(false)
  annualAllowance    Decimal? @db.Decimal(6, 2) // NULL = not configured
  allowNegativeBalance Boolean @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  requests LeaveRequest[]
  ledger   LeaveLedgerEntry[]
}

/// Balance = SUM of ledger entries. Append-only: gives history and auditability.
model LeaveLedgerEntry {
  id             String     @id @default(cuid())
  employeeId     String
  leaveTypeId    String
  year           Int
  kind           LedgerKind
  days           Decimal    @db.Decimal(6, 2) // signed
  leaveRequestId String?
  note           String?
  createdById    String?
  createdAt      DateTime   @default(now())

  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType    LeaveType     @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)

  @@index([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id          String       @id @default(cuid())
  employeeId  String
  leaveTypeId String
  startDate   DateTime     @db.Date
  endDate     DateTime     @db.Date
  isHalfDay   Boolean      @default(false)
  halfDayPart HalfDayPart?
  days        Decimal      @db.Decimal(6, 2)
  reason      String?
  approverId  String?
  status      RequestStatus @default(PENDING)
  version     Int          @default(0) // optimistic concurrency
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  employee  Employee  @relation("LeaveRequester", fields: [employeeId], references: [id], onDelete: Restrict)
  approver  Employee? @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  events LeaveRequestEvent[]
  ledger LeaveLedgerEntry[]

  @@index([employeeId, startDate])
  @@index([status, approverId])
}

/// Decision / lifecycle history: actor, timestamp, action, comment (BR-006).
model LeaveRequestEvent {
  id             String        @id @default(cuid())
  leaveRequestId String
  actorId        String? // UserAccount id
  action         String // SUBMITTED | APPROVED | REJECTED | CLARIFICATION_REQUESTED | RESUBMITTED | CANCELLED
  comment        String?
  createdAt      DateTime      @default(now())

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@index([leaveRequestId, createdAt])
}

// ───────────────────────── Calendar, announcements ─────────────────────────

model Holiday {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  name        String
  isPublished Boolean  @default(false)
  location    String? // optional applicability
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, name])
  @@index([date])
}

model Announcement {
  id          String             @id @default(cuid())
  title       String
  body        String
  status      AnnouncementStatus @default(DRAFT)
  publishAt   DateTime?
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  audiences AnnouncementAudience[]

  @@index([status, publishAt])
}

model AnnouncementAudience {
  id             String       @id @default(cuid())
  announcementId String
  type           AudienceType
  departmentId   String?
  role           Role?

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Documents & letters ─────────────────────────

model EmployeeDocument {
  id           String           @id @default(cuid())
  employeeId   String
  category     DocumentCategory
  title        String
  fileName     String
  storageKey   String           @unique // opaque key; files are NOT publicly reachable
  mimeType     String
  sizeBytes    Int
  isSensitive  Boolean          @default(true)
  uploadedById String? // UserAccount id
  deletedAt    DateTime? // soft delete; retention policy pending (OQ-10)
  createdAt    DateTime         @default(now())

  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  letters  HRLetter[]

  @@index([employeeId, category])
}

/// Letter RECORDS only. Template generation needs client-approved templates (OQ-08).
model HRLetter {
  id           String       @id @default(cuid())
  employeeId   String
  type         LetterType
  status       LetterStatus @default(DRAFT)
  issuedAt     DateTime?
  issuedById   String?
  documentId   String?
  note         String?
  createdAt    DateTime     @default(now())

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  document EmployeeDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([employeeId])
}

// ───────────────────────── Notifications, settings, audit ─────────────────────────

model Notification {
  id          String    @id @default(cuid())
  userId      String
  type        String // e.g. LEAVE_REQUESTED, LEAVE_DECIDED
  title       String
  body        String?
  link        String? // in-app route to open
  readAt      DateTime?
  emailStatus String? // NOT_CONFIGURED | SENT | FAILED (never fake success)
  createdAt   DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

/// Key/value business settings: workplace name, timezone, grace period ... (persisted, FR settings requirement).
model OrganizationSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// Append-only audit trail. The application exposes NO update/delete path for this table.
model AuditLog {
  id         String       @id @default(cuid())
  actorId    String? // UserAccount id
  actorEmail String? // denormalised so the trail stays readable
  action     String // e.g. EMPLOYEE_UPDATED, LEAVE_APPROVED, EXPORT_GENERATED
  entityType String
  entityId   String?
  outcome    AuditOutcome @default(SUCCESS)
  before     Json?
  after      Json?
  comment    String?
  ip         String?
  createdAt  DateTime     @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action])
}
