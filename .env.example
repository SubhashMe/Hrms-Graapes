# Copy this file to .env at the project root and fill in your own values.
# Use the database connection string supplied by your team / Supabase project.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-this-with-a-random-secret-at-least-32-characters
SESSION_TTL_HOURS=8
COMPANY_TIMEZONE=Asia/Kolkata
