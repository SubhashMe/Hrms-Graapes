# Copy this file to ".env" (same folder) and edit the values.
# NEVER commit the real .env file. Everything below is a placeholder.

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/graapes_hrms?schema=public"

# --- API ---
NODE_ENV=development
API_PORT=4000
# Browser origin allowed to call the API (the Vite dev server)
WEB_ORIGIN=http://localhost:5173
# Long random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_MIN_32_CHARS
# Session lifetime in hours
SESSION_TTL_HOURS=8

# --- First Super Admin (used once by "npm run db:seed") ---
# No default password exists. Choose your own (min 12 characters) and change it after first login.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_MIN_12_CHARS
SUPER_ADMIN_NAME="Super Admin"

# --- Demo data ---
# true = also create clearly-labelled SYNTHETIC demo records (never use in production)
SEED_DEMO_DATA=false

# --- Business defaults (DEMO DEFAULTS, not client-approved policy) ---
COMPANY_TIMEZONE=Asia/Kolkata

# --- File storage (private, never served publicly) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
UPLOAD_MAX_MB=5
UPLOAD_ALLOWED_TYPES=application/pdf,image/png,image/jpeg

# --- Email (optional; leave blank = email is NOT sent, only in-app notifications) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
